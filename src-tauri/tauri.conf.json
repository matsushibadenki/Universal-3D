{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal 3D",
  "version": "0.1.0",
  "identifier": "studio.universal3d.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1534",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universal 3D",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600,
        "transparent": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:1534 ws://localhost:1534"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false
  }
}
